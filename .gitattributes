# Scripts e configs consumidos pelo Linux precisam de LF. Editar no Windows e
# commitar com CRLF faz o bash morrer com "\r: command not found" na VM.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
deploy/**       text eol=lf
requirements.txt text eol=lf
discloud.config text eol=lf
