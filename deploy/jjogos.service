[Unit]
Description=JJogos (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/jjogos
EnvironmentFile=/opt/jjogos/.env
# A porta é local: só o nginx fala com ela, o mundo entra pela 443.
Environment=PORT=8000
ExecStart=/opt/jjogos/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 \
          --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# O estado das salas de tela vive em memória; matar o processo derruba as
# transmissões, então damos tempo pro uvicorn fechar os WS com jeito.
KillSignal=SIGINT
TimeoutStopSec=30

# Endurecimento básico — o app só precisa escrever na própria pasta.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/jjogos

[Install]
WantedBy=multi-user.target
